# Database
DATABASE_URL=sqlite:///./focusai.db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
DEBUG=true
SCREENSHOT_INTERVAL=300
SCREENSHOT_RETENTION_DAYS=7

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
